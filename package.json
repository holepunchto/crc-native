{
  "name": "crc-native",
  "version": "1.1.8",
  "description": "libcrc JavaScript bindings for Node.js",
  "imports": {
    "#binding": {
      "bare": "./lib/binding/bare.js",
      "node": "./lib/binding/node.js"
    }
  },
  "main": "index.js",
  "files": [
    "index.js",
    "binding.c",
    "CMakeLists.txt",
    "lib",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:node && npm run test:bare",
    "test:bare": "brittle-bare --coverage test.mjs",
    "test:node": "brittle-node --coverage test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/crc-native.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/crc-native/issues"
  },
  "homepage": "https://github.com/holepunchto/crc-native#readme",
  "dependencies": {
    "require-addon": "^1.1.0"
  },
  "devDependencies": {
    "bare-compat-napi": "^1.3.9",
    "brittle": "^3.1.0",
    "cmake-bare": "^1.1.7",
    "cmake-fetch": "^1.1.0",
    "cmake-napi": "^1.0.2",
    "cmake-npm": "^1.1.2",
    "lunte": "^1.3.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^1.0.0"
  }
}
